{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lean Teams",
  "mainBinaryName": "lean-teams",
  "version": "0.1.0",
  "identifier": "dev.leanteams.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg", "app"],
    "category": "Business",
    "shortDescription": "Unofficial lightweight Microsoft Teams client",
    "longDescription": "A tiny native shell around the official Microsoft Teams web app. Uses the operating system's webview instead of shipping its own browser engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
