{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "teams-remote",
  "description": "The only IPC surface exposed to the Teams web app: native notifications, and opening chat links in the default browser.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://teams.microsoft.com/*",
      "https://teams.cloud.microsoft/*",
      "https://teams.live.com/*"
    ]
  },
  "permissions": ["allow-notify", "allow-open-link"]
}
