{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-panel",
  "description": "The local overlay menu window (dist/panel.html): read and change overlay settings, custom.css and which mods are on.",
  "windows": ["overlay-panel"],
  "permissions": [
    "allow-overlay-state",
    "allow-overlay-update",
    "allow-overlay-toggle-mod",
    "allow-overlay-open-folder",
    "allow-overlay-devtools",
    "allow-overlay-menu-toggle"
  ]
}
