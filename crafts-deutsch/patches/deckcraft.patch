+/// The `dict-*` folders of a LibreOffice extensions folder (each holds a language's `.aff`/`.dic`).
+fn libreoffice_dicts(extensions: &Path) -> Vec<PathBuf> {
+    let Ok(rd) = std::fs::read_dir(extensions) else { return vec![] };
+    let mut dirs: Vec<PathBuf> = rd
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| p.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.starts_with("dict-")))
+        .collect();
+    dirs.sort();
