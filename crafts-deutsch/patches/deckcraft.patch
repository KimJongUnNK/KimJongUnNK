+    circumfix: Option<Flag>,
+    /// `CHECKSHARPS`: `SS` in a word in capitals may stand for `ß` (`STRASSE`).
+    check_sharps: bool,
+    /// Suffix rules by appended text, and the longest appended text (in characters).
+    sfx_by_add: HashMap<String, Vec<usize>>,
+    max_sfx_add: usize,
+    /// Per flag: the suffix rules whose continuation classes hold it.
+    sfx_with_cont: HashMap<Flag, Vec<usize>>,
+}
+
+/// One way a word is built: a root's flags with at most one prefix and two suffixes (`sfx` the
+/// outer one, `sfx2` the one applied to the root first).
+struct Analysis<'a> {
+    root: &'a [Flag],
+    pfx: Option<&'a Affix>,
+    sfx: Option<&'a Affix>,
+    sfx2: Option<&'a Affix>,
+}
+
+impl Analysis<'_> {
+    fn affixes(&self) -> impl Iterator<Item = &Affix> {
+        [self.pfx, self.sfx, self.sfx2].into_iter().flatten()
+    }
+
+    fn suffixes(&self) -> impl Iterator<Item = &Affix> {
+        [self.sfx, self.sfx2].into_iter().flatten()
+    }
+
+    /// Does an affix's continuation classes hold `f`?
+    fn cont_has(&self, f: Option<Flag>) -> bool {
+        f.is_some_and(|f| self.affixes().any(|a| a.cont.contains(&f)))
+    }
+
+    /// Does the root or an affix's continuation classes hold `f`?
+    fn has(&self, f: Option<Flag>) -> bool {
+        f.is_some_and(|f| self.root.contains(&f)) || self.cont_has(f)
+    }
+}
+
+/// Where a part sits in a compound.
+#[derive(Clone, Copy, PartialEq)]
+enum Part {
+    Begin,
+    Middle,
+    End,
+}
+
+/// Most parts a compound is split into when the dictionary sets no `COMPOUNDWORDMAX`.
+const DEFAULT_COMPOUND_PARTS: usize = 8;
+
+/// The items of a `MAP` line: single letters, or the letters of a `(…)` group as one item.
+fn map_items(text: &str) -> Vec<String> {
+    let mut out = vec![];
+    let mut group: Option<String> = None;
+    for c in text.chars() {
+        match (c, group.as_mut()) {
+            ('(', None) => group = Some(String::new()),
+            (')', Some(_)) => {
+                if let Some(g) = group.take().filter(|g| !g.is_empty()) {
+                    out.push(g);
+                }
+            }
+            (c, Some(g)) => g.push(c),
+            (c, None) => out.push(c.to_string()),
+        }
+    }
+    out
+}
+
+/// The spellings of `lower` (a word in capitals, lowered) with `ss` read as `ß` at some of its
+/// first five places, each at least once.
+fn sharp_s_spellings(lower: &str) -> Vec<String> {
+    let at: Vec<usize> = lower.match_indices("ss").map(|(i, _)| i).take(5).collect();
+    let mut out = vec![];
+    for pick in 1u32..(1u32 << at.len()) {
+        let (mut v, mut last) = (String::with_capacity(lower.len()), 0);
+        for (k, &i) in at.iter().enumerate() {
+            if pick & (1 << k) == 0 || i < last {
+                continue;
+            }
+            v.push_str(lower.get(last..i).unwrap_or_default());
+            v.push('ß');
+            last = i + 2;
+        }
+        v.push_str(lower.get(last..).unwrap_or_default());
+        if !out.contains(&v) {
+            out.push(v);
+        }
+    }
+    out
 }
 
