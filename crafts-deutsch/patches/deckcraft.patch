+/// A system locale as a BCP 47 tag: `de_AT.UTF-8` → `de-AT`; `None` for `C`, `POSIX` or junk.
+fn normalize_locale(l: &str) -> Option<String> {
+    let l = l.split(['.', '@']).next().unwrap_or("").trim();
+    let mut parts = l.split(['-', '_']);
+    let lang = parts.next().filter(|p| (2..=3).contains(&p.len()) && p.chars().all(|c| c.is_ascii_alphabetic()))?.to_ascii_lowercase();
+    let region = parts.find(|p| p.len() == 2 && p.chars().all(|c| c.is_ascii_alphabetic()));
+    Some(match region {
+        Some(r) => format!("{lang}-{}", r.to_ascii_uppercase()),
+        // A bare German is Germany's (the dictionaries are named by region).
+        None if lang == "de" => "de-DE".into(),
+        None => lang,
+    })
+}
