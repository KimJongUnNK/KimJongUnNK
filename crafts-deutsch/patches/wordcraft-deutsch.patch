+
+    /// Is `w[from..]` the rest of a compound: an end part, or a middle part and a rest?
+    fn compound_tail(&self, w: &str, from: usize, bounds: &[usize], parts: usize, deny: Mask, tails: &mut HashMap<usize, bool>) -> bool {
+        if let Some(&known) = tails.get(&from) {
