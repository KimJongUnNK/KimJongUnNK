+//! Hand-written synthetic German test data, shaped like the compounding of the igerman98
+//! dictionaries (begin, middle and end flags on suffix continuation classes, compound-only
+//! lower-case stems, `NEEDAFFIX`, `CHECKSHARPS`). No words, rules or tables were copied from a
+//! system dictionary; this is a small fixture, not a redistributable German dictionary.
+
+use crate::affix::AffixDict;
+
+pub const AFF: &str = "SET UTF-8
+TRY esijanrtolcdugmphbyfvkwqxzäüößESIJANRTOLCDUGMPHBYFVKWQXZÄÜÖ
+MAP 2
+MAP (ss)ß
+MAP (ue)ü
+CHECKSHARPS
+COMPOUNDBEGIN x
+COMPOUNDMIDDLE y
+COMPOUNDEND z
+COMPOUNDPERMITFLAG c
+ONLYINCOMPOUND o
+NEEDAFFIX h
+FORBIDDENWORD d
+COMPOUNDMIN 2
+WORDCHARS ß-.
+BREAK 1
+BREAK -
+SFX S Y 1
+SFX S 0 s .
+SFX N Y 1
+SFX N 0 n .
+SFX E Y 1
+SFX E 0 en .
+SFX R Y 2
+SFX R 0 er .
+SFX R 0 ern .
+SFX p Y 2
+SFX p aus äuser [hH]aus
+SFX p aus äusern [hH]aus
+SFX j Y 3
+SFX j 0 0/xoc .
+SFX j 0 -/zocf .
+SFX j 0 -/cz .
+SFX u Y 1
+SFX u 0 n/xoc .
+SFX t Y 1
+SFX t 0 s/xoc .
+SFX e Y 2
+SFX e 0 0/yoc .
+SFX e 0 -/zc .
+PFX k Y 2
+PFX k 0 -/coxf .
+PFX k 0 0/coy .
+PFX m Y 1
+PFX m T -t T
+";
+
+pub const DIC: &str = "22
+Haus/pj
+haus/hke
+haus/oz
+Tür/Ejm
+tür/hke
+tür/Eoz
+Kaffee/Sj
+kaffee/hke
+kaffee/Soz
+Club/Sj
+club/hke
+club/Soz
+Gründer/NSj
+gründer/NSoz
+Arbeit/Et
+recht/hke
+recht/Eoz
+gehen
+ging
+Straße/Eju
+straße/Eoz
+bahn/Eoz
+";
+
+/// The fixture as a dictionary.
+pub fn dict() -> AffixDict {
+    AffixDict::from_hunspell(AFF, DIC, &["synthetic German test data"]).unwrap_or_default()
+}
