+/// A German interface, or an English one on a German-speaking system, writes new documents in
+/// the region's German: Austria's on an Austrian system, Switzerland's on a Swiss one.
+#[test]
+fn new_documents_follow_the_regions_german() {
+    let mut s = s();
+    s.system_region = wordcraft_geom::Region::from_tag("de_AT.UTF-8");
+    assert_eq!(s.region_german().as_deref(), Some("de-AT"));
+    s.set_editing_language(s.region_german().as_deref());
+    assert_eq!(s.doc.styles.default_chr.lang.as_deref(), Some("de-AT"), "the untouched document follows");
+    assert_eq!(wordcraft_proof::ProofLang::from_tag(s.doc.styles.default_chr.lang.as_deref()), wordcraft_proof::ProofLang::DeAt);
+    for (tag, german) in [
+        ("de-CH", Some("de-CH")),
+        ("de-DE", Some("de-DE")),
+        ("deu-LI", Some("de-LI")),
+        ("de", Some("de-DE")),
+        ("en-US", None),
+        ("fr-FR", None),
+        ("auto", Some("de-AT")),
+    ] {
+        run(&mut s, "file.options", json!({"region": tag}));
+        assert_eq!(s.region_german().as_deref(), german, "{tag}");
+    }
+    s.system_region = wordcraft_geom::Region::from_tag("en_GB.UTF-8");
+    assert_eq!(s.region_german(), None);
+}
