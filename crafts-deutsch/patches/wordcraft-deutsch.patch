+/// The canonical name of a compounding directive whose argument is one flag (`COMPOUNDFIRST` is
+/// `COMPOUNDBEGIN`, `PSEUDOROOT` is `NEEDAFFIX`), or `None` for any other directive.
+fn compound_directive(d: &str) -> Option<&'static str> {
+    Some(match d {
+        "COMPOUNDFLAG" => "COMPOUNDFLAG",
+        "COMPOUNDBEGIN" | "COMPOUNDFIRST" => "COMPOUNDBEGIN",
+        "COMPOUNDMIDDLE" => "COMPOUNDMIDDLE",
+        "COMPOUNDEND" | "COMPOUNDLAST" => "COMPOUNDEND",
+        "COMPOUNDPERMITFLAG" => "COMPOUNDPERMITFLAG",
+        "COMPOUNDFORBIDFLAG" => "COMPOUNDFORBIDFLAG",
+        "ONLYINCOMPOUND" => "ONLYINCOMPOUND",
+        "NEEDAFFIX" | "PSEUDOROOT" => "NEEDAFFIX",
+        "CIRCUMFIX" => "CIRCUMFIX",
+        _ => return None,
+    })
+}
+
+/// The items of a `MAP` line: single letters, or the letters of a `(…)` group as one item.
+fn map_items(text: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut group: Option<String> = None;
+    for c in text.chars() {
+        match (c, group.as_mut()) {
+            ('(', None) => group = Some(String::new()),
+            (')', Some(_)) => {
+                if let Some(g) = group.take().filter(|g| !g.is_empty()) {
+                    out.push(g);
+                }
+            }
+            (c, Some(g)) => g.push(c),
+            (c, None) => out.push(c.to_string()),
+        }
+    }
+    out.dedup();
+    out
+}
