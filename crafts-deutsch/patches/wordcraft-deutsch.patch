@@ -0,0 +1,342 @@
+//! German proofing using the installed Hunspell dictionaries (never bundled in the source: the
+//! igerman98 dictionaries are GPL-licensed; LibreOffice ships them as its `dict-de` extension
+//! (`de_DE_frami`, `de_AT_frami`, `de_CH_frami`), Debian and Ubuntu as `hunspell-de-de`,
+//! `hunspell-de-at` and `hunspell-de-ch`). Each variety reads its own dictionary: Germany
+//! ([`ProofLang::De`]) `de_DE`, Austria ([`ProofLang::DeAt`]) `de_AT` (`Jänner`, `Paradeiser`)
+//! and Switzerland ([`ProofLang::DeCh`]) `de_CH` (no `ß`: `Strasse`), each falling back to
+//! another German one.
+//!
+//! German builds words by compounding (`Kaffee` + `Club` + `Gründer` → `Kaffeeclubgründer`):
+//! the affix engine checks compounds part by part as the dictionary's compounding flags say
+//! ([`crate::affix`]), so compounds that aren't listed are correct and `KaffeeClub` or
+//! `haustür` are not. Hyphenated words are checked whole first (`E-Mail`, `Haustür-`, `-laken`),
+//! then part by part (`Kaffee-Club`). Suggestions use the dictionary's tables plus the German
+//! umlaut and `ß` spellings (`ae` → `ä`, `ss` → `ß`); grammar is the generic repeated-word and
+//! spacing checks with German messages; hyphenation uses the German patterns ([`crate::hyphen`]).
+
+pub mod grammar;
+#[cfg(test)]
+pub(crate) mod test_dict;
+
+use std::sync::Arc;
+
+use crate::ProofLang;
+use crate::affix::AffixDict;
+use crate::affix_suggest::{Split, Tuning};
+use crate::slot::DictSlot;
+
+/// The dictionary of each variety, found on first use (see [`DictSlot`]).
+pub(crate) static GERMANY_DICT: DictSlot<AffixDict> = DictSlot::new(GERMANY, "German (Germany)");
+pub(crate) static AUSTRIA_DICT: DictSlot<AffixDict> = DictSlot::new(AUSTRIA, "German (Austria)");
+pub(crate) static SWITZERLAND_DICT: DictSlot<AffixDict> = DictSlot::new(SWITZERLAND, "German (Switzerland)");
+
+/// File names of a German Hunspell dictionary for Germany, most specific first (`_frami` is
+/// LibreOffice's name), then Austria's, which spells the same apart from a few words.
+const GERMANY: &[&str] = &["de_DE", "de-DE", "de_DE_frami", "de", "de_AT", "de_AT_frami"];
+/// For Austria: its own, then Germany's.
+const AUSTRIA: &[&str] = &["de_AT", "de-AT", "de_AT_frami", "de_DE", "de_DE_frami", "de"];
+/// For Switzerland (and Liechtenstein): its own, then Germany's (which wants `ß`).
+const SWITZERLAND: &[&str] = &["de_CH", "de-CH", "de_CH_frami", "de_LI", "de_DE", "de_DE_frami", "de"];
+
+/// `lang`'s variety's dictionary; Germany's for any other language.
+fn slot(lang: ProofLang) -> &'static DictSlot<AffixDict> {
+    match lang {
+        ProofLang::DeAt => &AUSTRIA_DICT,
+        ProofLang::DeCh => &SWITZERLAND_DICT,
+        _ => &GERMANY_DICT,
+    }
+}
+
+/// The Hunspell name each variety's dictionary is known by (`de_DE`, `de_AT`, `de_CH`).
+pub fn dictionary_name(lang: ProofLang) -> &'static str {
+    slot(lang).name()
+}
+
+/// The German dictionary of `lang`'s variety: the installed one (read on first use), one given
+/// with [`install_dictionary`], or an empty one when none is available (spelling is off then).
+pub fn dictionary(lang: ProofLang) -> Arc<AffixDict> {
+    slot(lang).get()
+}
+
+/// Use this dictionary for `lang`'s variety from now on (Hunspell `.aff` and `.dic` text,
+/// decoded to UTF-8). On error the current dictionary stays.
+pub fn install_dictionary(lang: ProofLang, aff: &str, dic: &str) -> Result<(), String> {
+    slot(lang).install(aff, dic)
+}
+
+/// Is a dictionary available for `lang`'s variety (spelling is checked)?
+pub fn has_dictionary(lang: ProofLang) -> bool {
+    slot(lang).has_dictionary()
+}
+
+/// Is `word` spelled correctly in `lang`'s German? Numbers, single letters, short words in
+/// capitals (acronyms: `EU`, `ORF`), words with digits and words in other scripts are accepted,
+/// and so is every word when no dictionary is installed for the variety.
+pub fn is_correct(word: &str, lang: ProofLang) -> bool {
+    is_correct_with(&dictionary(lang), word)
+}
+
+/// [`is_correct`] with the File › Options › Proofing choices.
+pub fn is_correct_with_options(word: &str, lang: ProofLang, opts: &crate::Options) -> bool {
+    check(&dictionary(lang), word, opts)
+}
+
+/// [`is_correct`] against a given dictionary (an empty one accepts everything).
+pub fn is_correct_with(d: &AffixDict, word: &str) -> bool {
+    check(d, word, &crate::Options::default())
+}
+
+/// [`is_correct_with_options`] against a given dictionary.
+fn check(d: &AffixDict, word: &str, opts: &crate::Options) -> bool {
+    // A leading hyphen belongs to the word (`Bettbezüge und -laken`): keep it for the whole-word
+    // check; quotes and other punctuation go.
+    let lead = word.trim_start_matches(|c: char| !c.is_alphanumeric() && c != '-');
+    let Some(w) = crate::spelling::word_to_check(d, word, opts) else {
+        return true;
+    };
+    let w = match lead.strip_prefix('-') {
+        Some(rest) if rest.starts_with(w) => lead.get(..w.len() + 1).unwrap_or(w),
+        _ => w,
+    };
+    if known(d, w) {
+        return true;
+    }
+    // Hyphenated words, part by part (`Kaffee-Club`, `Haustür-` before `und Fenster`).
+    w.contains('-') && w.split('-').all(|p| p.chars().count() <= 1 || known(d, p))
+}
+
+/// Is one word in the dictionary (a compound of its parts counts) or the user dictionary?
+fn known(d: &AffixDict, w: &str) -> bool {
+    d.check(w) || crate::in_user_dictionary(&w.to_lowercase())
+}
+
+/// The German confusions the dictionary's tables may lack: umlauts and `ß` typed without the
+/// letter (`ae`, `oe`, `ue`, `ss`) and the old spelling of `ss` after a short vowel (`daß`).
+const REP: &[(&str, &str)] = &[
+    ("ae", "ä"),
+    ("oe", "ö"),
+    ("ue", "ü"),
+    ("Ae", "Ä"),
+    ("Oe", "Ö"),
+    ("Ue", "Ü"),
+    ("ss", "ß"),
+    ("ß", "ss"),
+    ("dass", "das"),
+    ("das", "dass"),
+    ("ie", "i"),
+    ("i", "ie"),
+    ("h", ""),
+    ("ck", "k"),
+    ("k", "ck"),
+    ("tz", "z"),
+    ("z", "tz"),
+];
+
+/// The tuning of German suggestions: the dictionary's tables, umlauts with their bare letters,
+/// and the German alphabet when the dictionary has no TRY line.
+const TUNING: Tuning = Tuning {
+    split: Split::Anywhere,
+    alphabet: "esijanrtolcdugmphbyfvkwqxzäüößESIJANRTOLCDUGMPHBYFVKWQXZÄÜÖ",
+    map: &["aä", "oö", "uü", "AÄ", "OÖ", "UÜ", "sß"],
+    rep: REP,
+    ..Tuning::DEFAULT
+};
