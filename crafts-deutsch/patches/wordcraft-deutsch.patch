+/// The spellings of `lower` (a word in capitals, lowered) with `ss` read as `ß` at some of its
+/// first [`MAX_SHARP_S`] places, each at least once.
+fn sharp_s_spellings(lower: &str) -> Vec<String> {
+    let at: Vec<usize> = lower.match_indices("ss").map(|(i, _)| i).take(MAX_SHARP_S).collect();
+    let mut out = Vec::new();
+    for pick in 1u32..(1u32 << at.len()) {
+        let mut v = String::with_capacity(lower.len());
+        let mut last = 0;
+        let mut prev_end = 0;
+        for (k, &i) in at.iter().enumerate() {
+            // Overlapping places (`sss`): a later one inside a picked one is skipped.
+            if pick & (1 << k) == 0 || i < prev_end {
+                continue;
+            }
+            v.push_str(lower.get(last..i).unwrap_or_default());
+            v.push('ß');
+            last = i + 2;
+            prev_end = last;
+        }
+        v.push_str(lower.get(last..).unwrap_or_default());
+        if !out.contains(&v) {
+            out.push(v);
+        }
+    }
+    out
 }
 
