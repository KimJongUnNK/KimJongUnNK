+                w.get(from..j).is_some_and(|mid| self.part_ok(mid, Part::Middle, deny)) && self.compound_tail(w, j, bounds, parts + 1, deny, tails)
+            });
+        }
+        tails.insert(from, ok);
+        ok
+    }
