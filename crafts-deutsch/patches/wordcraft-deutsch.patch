+                && match at {
+                    Part::Begin | Part::Middle => a.suffixes().all(|r| r.cont.meets(c.permit)),
+                    Part::End => a.pfx.is_none_or(|r| r.cont.meets(c.permit)),
+                }
+                && self.affixes_ok(&a, true)
+        })
+    }
+
+    /// Is `w` a compound of dictionary parts (see the module docs)? Each tail is worked out once,
+    /// so a word costs at most a few hundred part lookups.
+    fn compound(&self, w: &str, deny: Mask) -> bool {
