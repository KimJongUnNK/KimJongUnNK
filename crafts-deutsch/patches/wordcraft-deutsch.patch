+/// Spelling suggestions for a German word in `lang`'s variety, best first, at most `max`, in the
+/// word's letter case.
+pub fn suggest(word: &str, max: usize, lang: ProofLang) -> Vec<String> {
+    suggest_in(&dictionary(lang), word, max)
+}
+
+/// [`suggest`] against a given dictionary.
+pub fn suggest_in(d: &AffixDict, word: &str, max: usize) -> Vec<String> {
+    crate::affix_suggest::suggest_in(d, word, max, &TUNING)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const VARIETIES: [ProofLang; 3] = [ProofLang::De, ProofLang::DeAt, ProofLang::DeCh];
+
+    #[test]
+    fn each_variety_looks_for_its_own_dictionary_first() {
+        let dir = std::env::temp_dir().join(format!("wordcraft-de-aliases-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let (de, at, ch) = (ProofLang::De, ProofLang::DeAt, ProofLang::DeCh);
+        for (name, found_by) in [
+            ("de_DE", &[de, at, ch][..]),
+            ("de_DE_frami", &[de, at, ch]),
+            ("de_AT", &[de, at]),
+            ("de_AT_frami", &[de, at]),
+            ("de_CH", &[ch]),
+            ("de_CH_frami", &[ch]),
+            ("de", &[de, at, ch]),
+        ] {
+            std::fs::write(dir.join(format!("{name}.aff")), test_dict::AFF).unwrap();
+            std::fs::write(dir.join(format!("{name}.dic")), test_dict::DIC).unwrap();
+            for lang in VARIETIES {
+                let found = crate::hunspell::find_in(&dir, slot(lang).names()).is_some();
+                assert_eq!(found, found_by.contains(&lang), "{name} for {lang:?}");
+            }
+            std::fs::remove_file(dir.join(format!("{name}.aff"))).unwrap();
+            std::fs::remove_file(dir.join(format!("{name}.dic"))).unwrap();
+        }
+        // Each variety prefers its own over a neighbour's.
+        for name in ["de_DE", "de_AT", "de_CH"] {
+            std::fs::write(dir.join(format!("{name}.aff")), test_dict::AFF).unwrap();
+            std::fs::write(dir.join(format!("{name}.dic")), test_dict::DIC).unwrap();
+        }
+        for (lang, want) in [(de, "de_DE"), (at, "de_AT"), (ch, "de_CH")] {
+            let (_, dic) = crate::hunspell::find_in(&dir, slot(lang).names()).unwrap();
+            assert_eq!(dic.file_stem().unwrap(), want, "{lang:?}");
+        }
+        std::fs::remove_dir_all(dir).unwrap();
+        assert_eq!(dictionary_name(de), "de_DE");
+        assert_eq!(dictionary_name(at), "de_AT");
+        assert_eq!(dictionary_name(ch), "de_CH");
+    }
+
+    #[test]
+    fn german_words_compounds_case_and_hyphens() {
+        let d = test_dict::dict();
+        for w in [
+            "Haus",
+            "Häuser",
+            "Tür",
+            "Türen",
+            "Haustür",
+            "Haustüren",
+            "Kaffee",
+            "Club",
+            "Kaffeeclub",
+            "Gründer",
+            "Kaffeeclubgründer",
+            "Arbeitsrecht",
+            "gehen",
+            "Gehen",
+            "GEHEN",
+            "ging",
+            "Straße",
+            "STRASSE",
+            "Straßenbahn",
+            "Kaffee-Club",
+            "Haustür-",
+            "-tür",
+        ] {
+            assert!(is_correct_with(&d, w), "{w}");
+        }
+        for w in [
+            "haustür",
+            "KaffeeClub",
+            "club",
+            "clubs",
+            "tür",
+            "Hauss",
+            "Kaffeclub",
+            "Arbeits",
+            "Arbeit-Recht-x",
+            "Strasse",
+            "gehn",
+            "Haustürr",
+            "Gründerkaffee-Clubb",
+        ] {
+            assert!(!is_correct_with(&d, w), "{w}");
+        }
+        // Options: short capitals are acronyms by default only.
+        let strict = crate::Options { ignore_uppercase: false, ..Default::default() };
+        assert!(is_correct_with(&d, "HAUSX"), "short capitals are acronyms by default");
+        assert!(!check(&d, "HAUSX", &strict));
+        assert!(check(&d, "HAUS", &strict));
+        // No dictionary: no marks.
+        assert!(is_correct_with(&AffixDict::default(), "Kaffeclub"));
+    }
+
+    #[test]
+    fn german_suggestions() {
+        let d = test_dict::dict();
+        for (word, want) in
+            [("Hauss", "Haus"), ("Kaffeclub", "Kaffeeclub"), ("Strasse", "Straße"), ("Tuer", "Tür"), ("haustür", "Haustür"), ("Haustürr", "Haustür")]
+        {
+            let got = suggest_in(&d, word, 8);
+            assert!(got.contains(&want.into()), "{word}: {got:?}");
+            assert!(got.iter().all(|s| s.split(' ').all(|p| d.check(p))), "{word}: {got:?}");
+        }
+        // Compound-only stems are never offered on their own.
+        assert!(!suggest_in(&d, "clubb", 8).contains(&"club".into()));
+    }
+
+    #[test]
+    fn german_dispatch_messages_and_varieties() {
+        for lang in VARIETIES {
+            install_dictionary(lang, test_dict::AFF, test_dict::DIC).unwrap();
+        }
+        for tag in ["de", "de-DE", "de-AT", "de-CH", "de_AT.UTF-8", "deu", "ger"] {
+            assert!(crate::has_dictionary(Some(tag)), "{tag}");
+            assert!(crate::is_correct_for("Kaffeeclubgründer", Some(tag)), "{tag}");
+            assert!(!crate::is_correct_for("Kaffeclub", Some(tag)), "{tag}");
+        }
+        let text = "Der Kaffeclub ist ist schön.";
+        let issues = crate::check_text(text, &[(0..text.len(), ProofLang::DeAt)]);
+        let spelling: Vec<&str> = issues.iter().filter(|i| i.kind == crate::IssueKind::Spelling).map(|i| &text[i.start..i.end]).collect();
+        assert!(spelling.contains(&"Kaffeclub"), "{issues:?}");
+        let mark = issues.iter().find(|i| &text[i.start..i.end] == "Kaffeclub").unwrap();
+        assert_eq!(mark.message, "Möglicher Rechtschreibfehler");
+        assert_eq!(mark.lang, ProofLang::DeAt);
+        assert!(issues.iter().any(|i| i.kind == crate::IssueKind::Grammar && i.message.starts_with("Wiederholtes Wort")), "{issues:?}");
+        assert!(crate::suggest_in("Kaffeclub", 8, ProofLang::De).contains(&"Kaffeeclub".into()));
+        // English words in a German run are German misspellings, German ones in an English run
+        // English ones.
+        assert!(!crate::is_correct_in("Kaffeeclubgründer", ProofLang::En));
+        crate::add_word("Zqkaffeewort");
+        assert!(crate::is_correct_in("zqkaffeewort", ProofLang::De));
+    }
+
+    /// The real LibreOffice dictionaries, when `WORDCRAFT_GERMAN_DICTIONARIES` names a folder
+    /// holding them (never committed: they are GPL-licensed).
+    #[test]
+    fn real_german_dictionaries_when_available() {
+        let Some(dir) = std::env::var_os("WORDCRAFT_GERMAN_DICTIONARIES") else { return };
+        let dir = std::path::PathBuf::from(dir);
+        for (name, extra_good, extra_bad) in [
+            ("de_DE_frami", &["Straße", "Grüße", "Fußballweltmeisterschaft"][..], &["Grüsse", "Strasse"][..]),
+            ("de_AT_frami", &["Jänner", "Paradeiser", "Straße", "Fußballweltmeisterschaft"], &["Grüsse"]),
+            // Swiss spelling has no `ß`.
+            ("de_CH_frami", &["Strasse", "Grüsse", "Fussballweltmeisterschaft"], &["Fußball"]),
+        ] {
+            let Some((aff, dic)) = crate::hunspell::find_in(&dir, &[name]) else { continue };
+            let d = crate::hunspell::load(&aff, &dic).unwrap();
+            let good = [
+                "Haus",
+                "Haustür",
+                "Kaffeeclub",
+                "Kaffeeclubgründer",
+                "Rechtschreibprüfung",
+                "gehen",
+                "Gehen",
+                "gegangen",
+                "Donaudampfschifffahrt",
+                "Bundesverfassungsgericht",
+                "Veranstaltungstechnik",
+                "Geschäftsführer",
+                "Lehrerinnen",
+                "Projektmanagement",
+                "E-Mail",
+                "Kaffee-Club",
+                "Haustür-",
+            ];
+            for w in good.iter().chain(extra_good) {
+                assert!(is_correct_with(&d, w), "{name}: {w}");
+            }
+            for w in ["Hauss", "Kaffeclub", "haustür", "KaffeeClub", "Rechtschreiprüfung", "gehn", "club", "Arbeits"].iter().chain(extra_bad) {
+                assert!(!is_correct_with(&d, w), "{name}: {w}");
+            }
+            let t = std::time::Instant::now();
+            for (word, want) in [("Kaffeclub", "Kaffeeclub"), ("Rechtschreiprüfung", "Rechtschreibprüfung"), ("Hauss", "Haus")] {
+                let got = suggest_in(&d, word, 6);
+                assert!(got.contains(&want.into()), "{name}: {word}: {got:?}");
+            }
+            eprintln!("{name}: 3 suggestion calls in {:?}", t.elapsed());
+        }
+    }
+}
