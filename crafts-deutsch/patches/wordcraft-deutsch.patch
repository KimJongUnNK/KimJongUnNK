+    /// accepts one. Stems carrying a flag in `deny` (and forbidden ones) don't count.
+    fn analyze<'a>(&'a self, w: &str, deny: Mask, f: &mut dyn FnMut(Analysis<'a>) -> bool) -> bool {
+        if w.is_empty() || w.len() > MAX_WORD_BYTES {
+            return false;
+        }
+        if self.each_homonym(w, deny, &mut |root| f(Analysis { root, pfx: None, sfx: None, sfx2: None })) {
+            return true;
+        }
+        if self.analyze_suffixed(w, deny, None, f) {
+            return true;
+        }
+        let mut root = String::with_capacity(w.len() + 8);
+        for p in &self.prefixes {
+            let Some(rest) = w.strip_prefix(&*p.add) else { continue };
+            if rest.is_empty() {
+                continue;
+            }
+            root.clear();
+            root.push_str(&p.strip);
+            root.push_str(rest);
+            if !p.cond_matches(&root, false) {
+                continue;
+            }
+            if self.each_homonym(&root, deny, &mut |r| r.meets(p.bit) && f(Analysis { root: r, pfx: Some(p), sfx: None, sfx2: None })) {
+                return true;
+            }
+            if self.analyze_suffixed(&root, deny, Some(p), f) {
+                return true;
+            }
+        }
+        false
+    }
+
+    /// The analyses of `w` as a stem with one suffix, or two in a row (continuation classes);
+    /// with a prefix `pfx` taken off already, one suffix that combines with it.
+    fn analyze_suffixed<'a>(&'a self, w: &str, deny: Mask, pfx: Option<&'a Rule>, f: &mut dyn FnMut(Analysis<'a>) -> bool) -> bool {
+        let cuts = |w: &str| std::iter::once(w.len()).chain(w.char_indices().rev().map(|(i, _)| i).filter(|&i| i > 0)).collect::<Vec<_>>();
+        let mut root = String::with_capacity(w.len() + 8);
