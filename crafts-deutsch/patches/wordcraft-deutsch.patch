+                            };
+                            licensed && f(Analysis { root: s, pfx, sfx: Some(r), sfx2: None })
+                        });
+                        if hit {
+                            return true;
+                        }
+                    }
+                    if pfx.is_some() {
+                        continue;
+                    }
+                    // Two suffixes: `root` is itself a stem with a suffix whose classes hold `r`'s flag.
+                    let mut inner = String::with_capacity(root.len() + 8);
+                    for b2 in cuts(&root).into_iter().take(self.max_sfx_chars + 1) {
+                        let (Some(base2), Some(add2)) = (root.get(..b2), root.get(b2..)) else { continue };
+                        let Some(groups2) = self.sfx_index.get(add2) else { continue };
+                        for g2 in groups2 {
+                            inner.clear();
+                            inner.push_str(base2);
+                            inner.push_str(&g2.strip);
+                            for r2 in g2.rules.iter().filter_map(|&i| self.suffixes.get(i as usize)) {
+                                if r2.cont.meets(r.bit)
+                                    && r2.cond_matches(&inner, true)
+                                    && self.each_homonym(&inner, deny, &mut |s2| {
+                                        s2.meets(r2.bit) && f(Analysis { root: s2, pfx: None, sfx: Some(r), sfx2: Some(r2) })
+                                    })
+                                {
+                                    return true;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        false
+    }
+
+    /// May the affixes of `a` stand as they are: `NEEDAFFIX` stems have an affix that needs no
+    /// other, circumfixes come in pairs, and outside a compound nothing is `ONLYINCOMPOUND`.
+    fn affixes_ok(&self, a: &Analysis<'_>, in_compound: bool) -> bool {
+        let c = &self.cpd;
+        if !c.need_affix.is_empty() {
+            let mut affixes = a.affixes().peekable();
+            let affixed = affixes.peek().is_some();
+            let all_need = affixed && a.affixes().all(|r| r.cont.meets(c.need_affix));
+            if (a.root.meets(c.need_affix) && !affixed) || all_need {
+                return false;
+            }
+        }
+        if !c.circumfix.is_empty() {
+            let pfx = a.pfx.is_some_and(|r| r.cont.meets(c.circumfix));
+            let sfx = a.suffixes().any(|r| r.cont.meets(c.circumfix));
+            if pfx != sfx {
+                return false;
+            }
+        }
+        in_compound || !(a.root | a.conts()).meets(c.only_in_compound)
+    }
+
+    /// Can `part` be the part of a compound at `at`?
+    fn part_ok(&self, part: &str, at: Part, deny: Mask) -> bool {
+        let c = &self.cpd;
+        if part.chars().count() < c.min {
+            return false;
+        }
+        let need = c.flag
+            | match at {
+                Part::Begin => c.begin,
+                Part::Middle => c.middle,
