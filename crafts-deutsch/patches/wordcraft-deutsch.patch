@@ -0,0 +1,99 @@
+//! Generic repeated-word and spacing checks with German messages. Articles and relative
+//! pronouns that German repeats on purpose (`die die Zeitung liest`, `das, was`) aren't flagged;
+//! no German sentence-capital or comma rules are inferred.
+
+use crate::{Issue, IssueKind, ProofLang, words};
+
+/// Words German doubles on purpose: an article after a relative pronoun of the same form.
+const MAY_REPEAT: &[&str] = &["der", "die", "das", "dem", "den", "des"];
+
+fn issue(start: usize, end: usize, message: String, suggestions: Vec<String>, lang: ProofLang) -> Issue {
+    Issue { start, end, kind: IssueKind::Grammar, message, suggestions, lang }
+}
+
+/// The grammar issues of `text` in `lang` (one of the Germans).
+pub fn check(text: &str, lang: ProofLang) -> Vec<Issue> {
+    let mut issues = Vec::new();
+    repeated_words(text, &words(text), lang, &mut issues);
+    spaces(text, lang, &mut issues);
+    issues.sort_by_key(|i| (i.start, i.end));
+    issues
+}
+
+fn repeated_words(text: &str, ws: &[(usize, usize)], lang: ProofLang, v: &mut Vec<Issue>) {
+    for pair in ws.windows(2) {
+        let [(a0, b0), (a1, b1)] = pair else { continue };
+        let (Some(w0), Some(w1), Some(gap)) = (text.get(*a0..*b0), text.get(*a1..*b1), text.get(*b0..*a1)) else { continue };
+        let lower = w0.to_lowercase();
+        if !gap.is_empty()
+            && gap.chars().all(char::is_whitespace)
+            && w0.chars().all(char::is_alphabetic)
+            && lower == w1.to_lowercase()
+            && !MAY_REPEAT.contains(&lower.as_str())
+        {
+            v.push(issue(*a0, *b1, format!("Wiederholtes Wort: „{w1}“"), vec![w0.to_string()], lang));
+        }
+    }
+}
+
+fn spaces(text: &str, lang: ProofLang, v: &mut Vec<Issue>) {
+    for (i, c) in text.char_indices() {
+        if c != ' ' {
+            continue;
+        }
+        let rest = text.get(i + 1..).unwrap_or("");
+        let mut it = rest.chars();
+        let Some(p) = it.next() else { continue };
+        let after = it.next();
+        // A score keeps its spaces (`2 : 1`).
+        let ratio = p == ':'
+            && text.get(..i).and_then(|before| before.chars().next_back()).is_some_and(|c| c.is_ascii_digit())
+            && after == Some(' ')
+            && it.next().is_some_and(|c| c.is_ascii_digit());
+        let flag = !ratio
+            && match p {
+                ',' => true,
+                ';' => !matches!(after, Some(')' | '(' | '-' | 'P' | 'D')),
+                // ` ...` is an ellipsis, ` .5` a number.
+                '.' => !matches!(after, Some('.')) && !after.is_some_and(|a| a.is_ascii_digit()),
+                // ` :)` and the like are emoticons.
+                ':' | '!' | '?' => after.is_none_or(|a| a.is_whitespace() || matches!(a, '"' | '“' | '”' | '’' | '!' | '?')),
+                _ => false,
+            };
+        if flag {
+            v.push(issue(i, i + 1 + p.len_utf8(), "Leerzeichen vor Satzzeichen".into(), vec![p.to_string()], lang));
+        }
+    }
+    for (i, _) in text.match_indices("  ") {
+        if i > 0 && text.get(..i).is_some_and(|t| t.ends_with(' ')) {
+            continue;
+        }
+        v.push(issue(i, i + 2, "Doppeltes Leerzeichen".into(), vec![" ".into()], lang));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn repeated_words_and_spaces_have_german_messages() {
+        let text = "Haus haus ,  Tür.";
+        let issues = check(text, ProofLang::DeAt);
+        assert_eq!(issues.len(), 3, "{issues:?}");
+        assert_eq!(issues[0].message, "Wiederholtes Wort: „haus“");
+        assert_eq!(issues[0].suggestions, ["Haus"]);
+        assert!(issues.iter().any(|i| i.message == "Leerzeichen vor Satzzeichen" && &text[i.start..i.end] == " ,"));
+        assert!(issues.iter().any(|i| i.message == "Doppeltes Leerzeichen"));
+        assert!(issues.iter().all(|i| i.lang == ProofLang::DeAt && i.kind == IssueKind::Grammar));
+        for text in [
+            "Die Frau, die die Zeitung liest.",
+            "Er sagt, dass das das Beste ist.",
+            "z. B. das",
+            "Spiel 2 : 1 gewonnen",
+            "Lächeln :) und .5 Liter ...",
+        ] {
+            assert!(check(text, ProofLang::De).is_empty(), "{text}: {:?}", check(text, ProofLang::De));
+        }
+    }
+}
