index 0000000..309d372
--- /dev/null
+++ b/crates/interchange/src/filmora.rs
@@ -0,0 +1,895 @@
+//! Wondershare Filmora projects (`.wfp`, Filmora 9 and later), import only.
+//!
+//! A `.wfp` is a ZIP archive. `ProjectFolder/project_info.json` names the timeline's media id
+//! (`timeline_mediaId`); `ProjectFolder/Medias/<id>/timeline.wesproj` is the edit as JSON. Media
+//! is referenced by path (`file://…`), never embedded. The format was worked out from projects the
+//! user saved in Filmora 16 (black-box observation of our own files; no Filmora code was read).
+//!
+//! What maps:
+//! - every timeline (`timelineInfos`): the current one becomes the imported sequence, the others
+//!   nested sequences when a compound clip (type 7) uses them;
+//! - tracks (`trackType` 1 video, 2 audio) in their stacking order, clips (type 1 video, type 2
+//!   audio) with source in/out, timeline placement, constant speed and reverse; video and audio of
+//!   the same source at the same place are linked;
+//! - stills (Filmora places them at 3600 s of source time) start at source time zero;
+//! - titles (type 4, alone in a compound clip, as Filmora wraps them) become graphic clips with a
+//!   text layer: text, font, size, colour and position;
+//! - Transform (position, scale, rotation) to Motion; clip volume (dB) and mute; audio fades and
+//!   transitions (`postTransition` / `preTransition`) with their range.
+//!
+//! What is reported instead: Filmora effects, colour adjustments, masks, pan-and-zoom, keyframed
+//! speed and the AI features, which have no FilmCraft counterpart or cannot be read reliably.
+//!
+//! Time is in units of 100 ns (`10_000_000` per second); it maps onto ticks rounded to the nearest.
+
+use std::collections::{HashMap, HashSet};
+
+use filmcraft_geom::Vec2;
+use filmcraft_project::{
+    ClipId, EffectInstance, ItemId, ItemKind, Label, Param, ParamValue, Sequence, TrackItem, TrackKind, Transition, TransitionAlign, TransitionId, graphic,
+};
+use filmcraft_time::{FrameRate, TICKS_PER_SECOND, Tick};
+use serde_json::Value;
+
+use crate::common::{Builder, MediaSpec, empty_sequence, file_name, file_stem, kind_from_ext, settings_for, transition_effect};
+use crate::{Error, Format, ImportOptions, Imported, Report, Result};
+
+/// Filmora's time unit: 100 ns.
+const UNITS_PER_SECOND: i128 = 10_000_000;
+/// Filmora puts stills at this source time (one hour).
+const STILL_SOURCE_START: i64 = 3600 * 10_000_000;
+/// Largest archive member read (the timeline of a long project is a few MB).
+const MAX_MEMBER: usize = 64 << 20;
+/// Most central-directory entries walked (a project holds a few hundred thumbnails at most).
+const MAX_ENTRIES: usize = 100_000;
+/// How deep compound clips may nest (cycles are refused as well).
+const MAX_NESTING: usize = 16;
+
+/// Does `bytes` look like a Filmora project: a ZIP whose central directory holds
+/// `ProjectFolder/project_info.json`?
+pub(crate) fn sniff(bytes: &[u8]) -> bool {
+    bytes.starts_with(b"PK\x03\x04") && Zip::open(bytes).is_some_and(|z| z.find("ProjectFolder/project_info.json").is_some())
+}
+
+/// Filmora time to ticks, rounded to the nearest tick.
+fn ticks(units: i64) -> Tick {
+    let t = (units as i128 * TICKS_PER_SECOND as i128 + UNITS_PER_SECOND / 2).div_euclid(UNITS_PER_SECOND);
+    Tick(t.clamp(i64::MIN as i128, i64::MAX as i128) as i64)
+}
+
+// ---------------------------------------------------------------------------------------------
+// A minimal ZIP reader: stored and deflated members, found through the central directory.
+// ---------------------------------------------------------------------------------------------
+
+struct ZipEntry {
+    name: String,
+    method: u16,
+    compressed: usize,
+    size: usize,
+    local: usize,
+}
+
+struct Zip<'a> {
+    bytes: &'a [u8],
+    entries: Vec<ZipEntry>,
+}
+
+fn u16_at(b: &[u8], i: usize) -> Option<u16> {
+    Some(u16::from_le_bytes(b.get(i..i + 2)?.try_into().ok()?))
+}
+
+fn u32_at(b: &[u8], i: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(b.get(i..i + 4)?.try_into().ok()?))
+}
+
+impl<'a> Zip<'a> {
+    fn open(bytes: &'a [u8]) -> Option<Zip<'a>> {
+        // End of central directory: the last `PK\5\6` within the final 64 KiB + 22 bytes.
+        let from = bytes.len().saturating_sub(0xFFFF + 22);
+        let eocd = (from..bytes.len().saturating_sub(21)).rev().find(|&i| bytes.get(i..i + 4) == Some(b"PK\x05\x06"))?;
+        let count = u16_at(bytes, eocd + 10)? as usize;
+        let mut at = u32_at(bytes, eocd + 16)? as usize;
+        let mut entries = Vec::new();
+        for _ in 0..count.min(MAX_ENTRIES) {
+            if bytes.get(at..at + 4) != Some(b"PK\x01\x02") {
+                break;
+            }
+            let method = u16_at(bytes, at + 10)?;
+            let compressed = u32_at(bytes, at + 20)? as usize;
+            let size = u32_at(bytes, at + 24)? as usize;
+            let name_len = u16_at(bytes, at + 28)? as usize;
+            let extra_len = u16_at(bytes, at + 30)? as usize;
+            let comment_len = u16_at(bytes, at + 32)? as usize;
+            let local = u32_at(bytes, at + 42)? as usize;
+            let name = String::from_utf8_lossy(bytes.get(at + 46..at + 46 + name_len)?).into_owned();
+            entries.push(ZipEntry { name, method, compressed, size, local });
+            at = at.checked_add(46 + name_len + extra_len + comment_len)?;
+        }
+        Some(Zip { bytes, entries })
+    }
+
+    fn find(&self, name: &str) -> Option<&ZipEntry> {
+        self.entries.iter().find(|e| e.name == name)
+    }
+
+    fn read(&self, e: &ZipEntry) -> std::result::Result<Vec<u8>, String> {
+        if e.size > MAX_MEMBER || e.compressed > MAX_MEMBER {
+            return Err(format!("{} is too large", e.name));
+        }
+        let b = self.bytes;
+        let bad = || format!("{} is damaged", e.name);
+        if b.get(e.local..e.local + 4) != Some(b"PK\x03\x04") {
+            return Err(bad());
+        }
+        let name_len = u16_at(b, e.local + 26).ok_or_else(bad)? as usize;
+        let extra_len = u16_at(b, e.local + 28).ok_or_else(bad)? as usize;
+        let start = e.local + 30 + name_len + extra_len;
+        let data = b.get(start..start + e.compressed).ok_or_else(bad)?;
+        match e.method {
+            0 => Ok(data.to_vec()),
+            8 => miniz_oxide::inflate::decompress_to_vec_with_limit(data, MAX_MEMBER).map_err(|_| bad()),
+            m => Err(format!("{} uses compression method {m}", e.name)),
+        }
+    }
+
+    fn json(&self, name: &str) -> Result<Value> {
+        let e = self.find(name).ok_or_else(|| Error::parse(Format::Filmora, format!("no {name} in the project")))?;
+        let bytes = self.read(e).map_err(|m| Error::parse(Format::Filmora, m))?;
+        let text = String::from_utf8_lossy(bytes.strip_prefix(&[0xef, 0xbb, 0xbf]).unwrap_or(&bytes)).into_owned();
+        serde_json::from_str(&text).map_err(|e| Error::parse(Format::Filmora, format!("{name}: {e}")))
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Import
+// ---------------------------------------------------------------------------------------------
+
+pub(crate) fn import(bytes: &[u8], opts: &ImportOptions, report: &mut Report) -> Result<Imported> {
+    let zip = Zip::open(bytes).ok_or_else(|| Error::parse(Format::Filmora, "not a ZIP archive"))?;
+    let info = zip.json("ProjectFolder/project_info.json")?;
+    let media_id = info.get("timeline_mediaId").and_then(Value::as_str).unwrap_or("");
+    let timeline_path = format!("ProjectFolder/Medias/{media_id}/timeline.wesproj");
+    let timeline_path = if zip.find(&timeline_path).is_some() {
+        timeline_path
+    } else {
+        // Older saves: whichever timeline the archive has.
+        zip.entries
+            .iter()
+            .map(|e| e.name.clone())
+            .find(|n| n.ends_with("/timeline.wesproj"))
+            .ok_or_else(|| Error::parse(Format::Filmora, "no timeline in the project"))?
+    };
+    let doc = zip.json(&timeline_path)?;
+    let name = opts
+        .name
+        .clone()
+        .or_else(|| info.get("project_file_name").and_then(Value::as_str).filter(|n| !n.is_empty()).map(str::to_string))
+        .unwrap_or_else(|| "Filmora Project".into());
+    let timelines: HashMap<i64, &Value> =
+        doc.get("timelineInfos").and_then(Value::as_array).into_iter().flatten().filter_map(|t| Some((t.get("timelineId")?.as_i64()?, t))).collect();
+    let current = doc
+        .get("currentTimelineId")
+        .and_then(Value::as_i64)
+        .filter(|id| timelines.contains_key(id))
+        .or_else(|| doc.get("timelineInfos").and_then(Value::as_array).and_then(|a| a.first()).and_then(|t| t.get("timelineId")).and_then(Value::as_i64));
+    let Some(current) = current else { return Err(Error::parse(Format::Filmora, "the project has no timeline")) };
+    let mut imp = Imp {
+        b: Builder::new(&name),
+        report,
+        timelines,
+        nested: HashMap::new(),
+        building: HashSet::new(),
+        links: HashMap::new(),
+        pairs: HashSet::new(),
+        ignored: Vec::new(),
+    };
+    let id = imp.timeline(current, &name, 0).ok_or_else(|| Error::parse(Format::Filmora, "the timeline could not be read"))?;
+    imp.b.top.push(id);
+    let mut ignored = std::mem::take(&mut imp.ignored);
+    ignored.sort();
+    ignored.dedup();
+    for what in ignored {
+        imp.report.warn(format!("Filmora {what} were not imported (no FilmCraft equivalent)"));
+    }
+    Ok(imp.b.finish())
+}
+
+struct Imp<'v, 'r> {
+    b: Builder,
+    report: &'r mut Report,
+    timelines: HashMap<i64, &'v Value>,
+    /// Compound clips' timelines already imported, as sequence items.
+    nested: HashMap<i64, ItemId>,
+    /// Timelines being imported (a compound clip that contains itself is refused).
+    building: HashSet<i64>,
+    /// (source, timeline start, timeline end) → link id, for video and audio of one clip.
+    links: HashMap<(String, i64, i64), u64>,
+    /// The (source, start, end) keys a video and an audio clip share: only those are linked.
+    pairs: HashSet<(String, i64, i64)>,
+    /// What was skipped, reported once each.
+    ignored: Vec<String>,
+}
+
+/// One clip as read, before it becomes a track item.
+struct Placed {
+    item: TrackItem,
+    /// Filmora's `postTransition` / `preTransition`, if any.
+    transitions: Vec<(String, Tick, Tick)>,
+    fades: (Option<Tick>, Option<Tick>),
+}
+
+fn i(v: &Value, k: &str) -> i64 {
+    v.get(k).and_then(Value::as_i64).unwrap_or(0)
+}
+
+fn rate_of(t: &Value) -> FrameRate {
+    let r = t.get("frameRate");
+    let num = r.and_then(|r| r.get("num")).and_then(Value::as_i64).unwrap_or(25);
+    let den = r.and_then(|r| r.get("den")).and_then(Value::as_i64).unwrap_or(1);
+    if num > 0 && den > 0 && num / den <= 1000 { FrameRate { num, den } } else { FrameRate { num: 25, den: 1 } }
+}
+
+/// `file://Volumes/x.mov` (Filmora for Mac leaves out the root slash), `file:///Users/…`,
+/// `file:///C:/…` → a local path.
+fn path_of(url: &str) -> String {
+    let Some(rest) = url.get(..7).filter(|p| p.eq_ignore_ascii_case("file://")).and(url.get(7..)) else { return url.to_string() };
+    // Not a host: Filmora writes the path right after `file://`.
+    let rooted = if rest.starts_with('/') { rest.to_string() } else { format!("/{rest}") };
+    crate::common::file_url_to_path(&format!("file://{rooted}"))
+}
+
+/// The effect-list entries (`display`, parameters) of a clip's effect chain `chain`.
+fn effects<'v>(c: &'v Value, chain: &str) -> impl Iterator<Item = &'v Value> + 'v {
+    let chain = chain.to_string();
+    c.get("effectChainList")
+        .and_then(Value::as_array)
+        .into_iter()
+        .flatten()
+        .filter(move |e| e.get("name").and_then(Value::as_str) == Some(chain.as_str()))
+        .flat_map(|e| e.get("effectList").and_then(Value::as_array).into_iter().flatten())
+}
+
+fn display(e: &Value) -> &str {
+    e.get("display").and_then(Value::as_str).unwrap_or("")
+}
+
+/// A parameter of an effect-list entry, as a number (`fxParam.unValue`).
+fn num(e: &Value, name: &str) -> Option<f64> {
+    e.get("paramList")?.as_array()?.iter().find(|p| p.get("name").and_then(Value::as_str) == Some(name))?.get("fxParam")?.get("unValue")?.as_f64()
+}
+
+fn flag(e: &Value, name: &str) -> Option<bool> {
+    let v = e.get("paramList")?.as_array()?.iter().find(|p| p.get("name").and_then(Value::as_str) == Some(name))?.get("fxParam")?.get("unValue")?.clone();
+    v.as_bool().or_else(|| v.as_i64().map(|n| n != 0))
+}
+
+/// Constant speed and reverse from `speed.speedParam`; `None` speed for a ramp.
+fn speed_of(c: &Value) -> (Option<f64>, bool) {
+    let s = c.get("speed");
+    let reverse = s.and_then(|s| s.get("reverse")).and_then(Value::as_bool).unwrap_or(false);
+    let Some(param) = s.and_then(|s| s.get("speedParam")).and_then(Value::as_str) else { return (Some(1.0), reverse) };
+    let Ok(p) = serde_json::from_str::<Value>(param) else { return (Some(1.0), reverse) };
+    let values: Vec<f64> =
+        p.get("keyframeSets").and_then(Value::as_array).into_iter().flatten().filter_map(|k| k.get("_value").and_then(Value::as_f64)).collect();
+    match values.first() {
+        None => (Some(1.0), reverse),
+        Some(&v) if values.iter().all(|x| (x - v).abs() < 1e-6) && v > 0.0 && v.is_finite() => (Some(v), reverse),
+        _ => (None, reverse),
+    }
+}
+
+fn set(ti: &mut TrackItem, effect: &str, param: &str, v: ParamValue) {
+    crate::common::set_param(ti, effect, param, Param::new(v));
+}
+
+impl Imp<'_, '_> {
+    fn skip(&mut self, what: &str) {
+        self.ignored.push(what.to_string());
+    }
+
+    /// Import timeline `id` as a sequence item (the top one, or a compound clip's).
+    fn timeline(&mut self, id: i64, name: &str, depth: usize) -> Option<ItemId> {
+        // A timeline still being built is an ancestor: using it would nest a sequence in itself.
+        if depth > MAX_NESTING || self.building.contains(&id) {
+            self.report.warn("a Filmora compound clip that contains itself was skipped");
+            return None;
+        }
+        if let Some(&done) = self.nested.get(&id) {
+            return Some(done);
+        }
+        self.building.insert(id);
+        let t = *self.timelines.get(&id)?;
+        let rate = rate_of(t);
+        let (w, h) = (i(t, "resolutionWidth").clamp(16, 16384) as u32, i(t, "resolutionHeight").clamp(16, 16384) as u32);
+        let settings = settings_for(rate, w, h, false);
+        let item = self.b.reserve_sequence(name, settings.clone(), None);
+        self.nested.insert(id, item);
+        let mut seq = empty_sequence(settings);
+        let mut kinds: HashMap<(String, i64, i64), (bool, bool)> = HashMap::new();
+        for tr in t.get("trackInfos").and_then(Value::as_array).into_iter().flatten() {
+            for c in tr.get("clipList").and_then(Value::as_array).into_iter().flatten() {
+                let Some(src) = c.get("sourceUuid").and_then(Value::as_str).filter(|s| !s.is_empty()) else { continue };
+                let k = kinds.entry((src.to_string(), i(c, "tlBegin"), i(c, "tlEnd"))).or_default();
+                match i(c, "type") {
+                    1 => k.0 = true,
+                    2 => k.1 = true,
+                    _ => {}
+                }
+            }
+        }
+        self.pairs.extend(kinds.into_iter().filter(|(_, (v, a))| *v && *a).map(|(k, _)| k));
+        for tr in t.get("trackInfos").and_then(Value::as_array).into_iter().flatten() {
+            let kind = if i(tr, "trackType") == 2 { TrackKind::Audio } else { TrackKind::Video };
+            self.track(&mut seq, tr, kind, (w, h, rate), depth);
+        }
+        self.b.ensure_tracks(&mut seq, TrackKind::Video, 1);
+        self.b.ensure_tracks(&mut seq, TrackKind::Audio, 1);
+        self.b.put_sequence(item, seq);
+        self.building.remove(&id);
+        Some(item)
+    }
+
+    fn track(&mut self, seq: &mut Sequence, tr: &Value, kind: TrackKind, frame: (u32, u32, FrameRate), depth: usize) {
+        let index = seq.tracks(kind).len();
+        let mut track = self.b.track(kind, index);
+        let mut placed: Vec<Placed> = Vec::new();
+        for c in tr.get("clipList").and_then(Value::as_array).into_iter().flatten() {
+            if let Some(p) = self.clip(c, kind, frame, depth) {
+                placed.push(p);
+            }
+        }
+        placed.sort_by_key(|p| p.item.start);
+        // No overlaps on one track: a clip that starts inside the previous one is cut to fit.
+        for k in 1..placed.len() {
+            let prev_end = placed[k - 1].item.end();
+            let cur = &mut placed[k].item;
+            if cur.start < prev_end {
+                let cut = prev_end - cur.start;
+                if cut >= cur.duration {
+                    cur.duration = Tick::ZERO;
+                } else {
+                    cur.duration -= cut;
+                    cur.source_in += crate::common::scaled(cut, cur.speed);
+                    cur.start = prev_end;
+                }
+            }
+        }
+        placed.retain(|p| p.item.duration > Tick::ZERO);
+        let audio = kind == TrackKind::Audio;
+        let ids: Vec<(ClipId, Tick, Tick)> = placed.iter().map(|p| (p.item.id, p.item.start, p.item.end())).collect();
+        for (k, p) in placed.iter().enumerate() {
+            let (id, start, end) = ids[k];
+            let prev = k.checked_sub(1).map(|j| ids[j]).filter(|q| q.2 == start).map(|q| q.0);
+            let next = ids.get(k + 1).filter(|q| q.1 == end).map(|q| q.0);
+            for (name, t0, t1) in &p.transitions {
+                if t1 <= t0 {
+                    continue;
+                }
+                // Which cut the transition belongs to: the one it is nearer.
+                let at_end = (*t1 - end).0.abs() <= (*t0 - start).0.abs();
+                let (cut, from, to) = if at_end { (end, Some(id), next) } else { (start, prev, Some(id)) };
+                let align = if *t1 <= cut {
+                    TransitionAlign::EndAtCut
+                } else if *t0 >= cut {
+                    TransitionAlign::StartAtCut
+                } else {
+                    TransitionAlign::CenterAtCut
+                };
+                let effect = transition_effect(name, audio, self.report);
+                track.transitions.push(Transition {
+                    id: TransitionId(self.b.alloc()),
+                    effect,
+                    start: *t0,
+                    duration: *t1 - *t0,
+                    from,
+                    to,
+                    align,
+                    reverse: false,
+                });
+            }
+            if audio {
+                if let Some(d) = p.fades.0.filter(|d| *d > Tick::ZERO) {
+                    let effect = transition_effect("Cross Fade (+3dB)", true, self.report);
+                    track.transitions.push(Transition {
+                        id: TransitionId(self.b.alloc()),
+                        effect,
+                        start,
+                        duration: d.min(end - start),
+                        from: None,
+                        to: Some(id),
+                        align: TransitionAlign::StartAtCut,
+                        reverse: false,
+                    });
+                }
+                if let Some(d) = p.fades.1.filter(|d| *d > Tick::ZERO) {
+                    let d = d.min(end - start);
+                    let effect = transition_effect("Cross Fade (+3dB)", true, self.report);
+                    track.transitions.push(Transition {
+                        id: TransitionId(self.b.alloc()),
+                        effect,
+                        start: end - d,
+                        duration: d,
+                        from: Some(id),
+                        to: None,
+                        align: TransitionAlign::EndAtCut,
+                        reverse: false,
+                    });
+                }
+            }
+        }
+        track.items = placed.into_iter().map(|p| p.item).collect();
+        track.sort();
+        seq.tracks_mut(kind).push(track);
+    }
+
+    fn clip(&mut self, c: &Value, kind: TrackKind, frame: (u32, u32, FrameRate), depth: usize) -> Option<Placed> {
+        let ty = i(c, "type");
+        let (tl0, tl1) = (i(c, "tlBegin"), i(c, "tlEnd"));
+        if tl1 <= tl0 {
+            return None;
+        }
+        let (start, duration) = (ticks(tl0), ticks(tl1) - ticks(tl0));
+        let source = c.get("sourceUuid").and_then(Value::as_str).unwrap_or("").to_string();
+        let mut ti = match ty {
+            1 | 2 => {
+                let url = c.get("filename").and_then(Value::as_str).filter(|f| !f.is_empty())?;
+                let path = path_of(url);
+                let still = matches!(kind_from_ext(&path), filmcraft_media::MediaKind::Still);
+                let spec = MediaSpec {
+                    duration: None,
+                    video: (!matches!(kind_from_ext(&path), filmcraft_media::MediaKind::AudioOnly)).then_some(frame),
+                    audio: (kind == TrackKind::Audio || !still).then_some((48_000, 2)),
+                    start_tc: None,
+                    kind: Some(kind_from_ext(&path)),
+                };
+                let name = file_stem(&path).to_string();
+                let item = self.b.file_media(&format!("file:{path}"), file_name(&path), &path, &spec, None);
+                let in_point = i(c, "inPoint");
+                let source_in = if still { ticks((in_point - STILL_SOURCE_START).max(0)) } else { ticks(in_point.max(0)) };
+                let mut ti = self.b.clip(item, kind, &name, start, duration, source_in);
+                let (speed, reverse) = speed_of(c);
+                match speed {
+                    Some(s) => ti.speed = s,
+                    None => {
+                        // A ramp: keep the clip's average rate so it covers the same source.
+                        let src = ticks(i(c, "outPoint") - in_point);
+                        if duration > Tick::ZERO && src > Tick::ZERO {
+                            ti.speed = (src.0 as f64 / duration.0 as f64).clamp(0.01, 100.0);
+                        }
+                        self.report.warn("Filmora speed ramps were imported at their average speed");
+                    }
+                }
+                ti.reverse = reverse;
+                if !still && kind == TrackKind::Video {
+                    // Filmora fits footage to the frame.
+                    ti.scale_to_frame = true;
+                }
+                ti
+            }
+            7 => {
+                let nested_id = i(c, "timelineId");
+                if let Some(ti) = self.title(nested_id, kind, frame, start, duration) {
+                    ti
+                } else {
+                    let item = self.timeline(nested_id, "Compound Clip", depth + 1)?;
+                    self.b.clip(item, kind, "Compound Clip", start, duration, ticks(i(c, "inPoint").max(0)))
+                }
+            }
+            4 => self.text_clip(c, frame, start, duration)?,
+            other => {
+                self.skip(&format!("clips of type {other}"));
+                return None;
+            }
+        };
+        let key = (source, tl0, tl1);
+        if matches!(ty, 1 | 2) && self.pairs.contains(&key) {
+            let next = self.b.link_id();
+            ti.link = Some(*self.links.entry(key).or_insert(next));
+        }
+        let fades = self.adjust(&mut ti, c, kind, frame);
+        let transitions = ["postTransition", "preTransition"]
+            .iter()
+            .filter_map(|k| c.get(*k))
+            .filter_map(|t| {
+                let (a, b) = (i(t, "tlBegin"), i(t, "tlEnd"));
+                let name = t.get("display").and_then(Value::as_str).unwrap_or("Dissolve").to_string();
+                (b > a).then(|| (name, ticks(a), ticks(b)))
+            })
+            .collect();
+        Some(Placed { item: ti, transitions, fades })
+    }
+
+    /// A compound clip whose timeline holds one title (how Filmora stores titles) as a graphic clip.
+    fn title(&mut self, nested: i64, kind: TrackKind, frame: (u32, u32, FrameRate), start: Tick, duration: Tick) -> Option<TrackItem> {
+        if kind != TrackKind::Video {
+            return None;
+        }
+        let t = *self.timelines.get(&nested)?;
+        let clips: Vec<&Value> = t
+            .get("trackInfos")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .flat_map(|tr| tr.get("clipList").and_then(Value::as_array).into_iter().flatten())
+            .collect();
+        let [text] = clips.as_slice() else { return None };
+        if i(text, "type") != 4 {
+            return None;
+        }
+        self.text_clip(text, frame, start, duration)
+    }
+
+    /// A Filmora title (type 4, `scriptBuf`) as a graphic clip with one text layer.
+    fn text_clip(&mut self, c: &Value, frame: (u32, u32, FrameRate), start: Tick, duration: Tick) -> Option<TrackItem> {
+        let script: Value = c.get("scriptBuf").and_then(Value::as_str).and_then(|s| serde_json::from_str(s).ok())?;
+        let raw = script.get("Text").and_then(Value::as_str).unwrap_or("");
+        let text = raw.replace("\r\n", "\n").replace('\r', "\n");
+        let (w, h, rate) = frame;
+        let lines = text.lines().count().max(1) as f64;
+        let data = script.get("TextData").and_then(Value::as_array).and_then(|a| a.first());
+        let basic = data.and_then(|d| d.get("Basic"));
+        // The title's box height is its lines; the font size follows from it (Filmora's own size is
+        // relative to its preview, not to the frame).
+        let box_h = script.get("ScaleY").and_then(Value::as_f64).filter(|v| *v > 0.0 && *v <= 4.0).map(|v| v * h as f64);
+        let size =
+            box_h.map(|bh| bh / (lines * 1.2)).or_else(|| basic.and_then(|b| b.get("FontSize")).and_then(Value::as_f64)).unwrap_or(100.0).clamp(4.0, 2000.0);
+        let cx = script.get("PosX").and_then(Value::as_f64).unwrap_or(0.5).clamp(-4.0, 4.0) * w as f64;
+        let cy = script.get("PosY").and_then(Value::as_f64).unwrap_or(0.5).clamp(-4.0, 4.0) * h as f64;
+        // Text position: the alignment point on the first baseline.
+        let first_baseline = cy - lines * size * 1.2 / 2.0 + size * 0.9;
+        let mut layer: EffectInstance = graphic::new_text_layer(&text, Vec2::new(cx, first_baseline), size);
+        let align = match script.get("Layout").and_then(|l| l.get("TextAlign")).and_then(Value::as_str) {
+            Some("left") => 0,
+            Some("right") => 2,
+            _ => 1,
+        };
+        layer.params.insert("align".into(), Param::new(ParamValue::Choice(align)));
+        if let Some(font) = basic.and_then(|b| b.get("FontName")).and_then(Value::as_str).filter(|f| !f.is_empty()) {
+            layer.params.insert("font".into(), Param::new(ParamValue::Text(font.to_string())));
+        }
+        if basic.and_then(|b| b.get("FontBold")).and_then(Value::as_i64) == Some(1) {
+            layer.params.insert("faux_bold".into(), Param::new(ParamValue::Bool(true)));
+        }
+        if basic.and_then(|b| b.get("FontItalic")).and_then(Value::as_i64) == Some(1) {
+            layer.params.insert("faux_italic".into(), Param::new(ParamValue::Bool(true)));
+        }
+        let color =
+            basic.and_then(|b| b.get("TextColor")).and_then(Value::as_array).and_then(|a| a.first()).and_then(|c| c.get("Color")).and_then(Value::as_i64);
+        if let Some(rgb) = color {
+            let alpha = basic.and_then(|b| b.get("TextAlpha")).and_then(Value::as_f64).unwrap_or(255.0).clamp(0.0, 255.0) / 255.0;
+            let ch = |shift: u32| ((rgb >> shift) & 0xFF) as f32 / 255.0;
+            layer.params.insert("fill_color".into(), Param::new(ParamValue::Color([ch(16), ch(8), ch(0), alpha as f32])));
+        }
+        let src = self.graphic_source(w, h, rate);
+        let name = text.lines().next().filter(|l| !l.trim().is_empty()).unwrap_or("Title").chars().take(40).collect::<String>();
+        let mut ti = self.b.clip(src, TrackKind::Video, &name, start, duration, Tick::ZERO);
+        ti.effects.push(layer);
+        graphic::ensure_layer_uids(&mut ti.effects);
+        if script.get("TemplatePath").and_then(Value::as_str).is_some_and(|p| !p.is_empty()) {
+            self.report.warn("Filmora title templates and animations were not imported (their text was)");
+        }
+        Some(ti)
+    }
+
+    fn graphic_source(&mut self, w: u32, h: u32, rate: FrameRate) -> ItemId {
+        let key = format!("graphic:{w}x{h}@{}/{}", rate.num, rate.den);
+        if let Some(id) = self.b.find_media(&key) {
+            return id;
+        }
+        let id = self.b.p.add_item("Graphic", Label::Rose, ItemKind::Graphic { width: w, height: h, rate }, None);
+        self.b.register_media(&key, id);
+        id
+    }
+
+    /// Transform, volume and the unsupported effects of a clip; returns its audio fades.
+    fn adjust(&mut self, ti: &mut TrackItem, c: &Value, kind: TrackKind, frame: (u32, u32, FrameRate)) -> (Option<Tick>, Option<Tick>) {
+        let (w, h, _) = frame;
+        let mut fades = (None, None);
+        if kind == TrackKind::Video {
+            for e in effects(c, "Basic") {
+                match display(e) {
+                    "transform" => {
+                        let (sx, sy) = (num(e, "Scale_x"), num(e, "Scale_y"));
+                        if let (Some(sx), Some(sy)) = (sx, sy)
+                            && sx.is_finite()
+                            && sy.is_finite()
+                        {
+                            set(ti, "motion", "scale", ParamValue::Float(sy.clamp(0.0, 10_000.0)));
+                            if (sx - sy).abs() > 1e-3 {
+                                set(ti, "motion", "uniform_scale", ParamValue::Bool(false));
+                                set(ti, "motion", "scale_width", ParamValue::Float(sx.clamp(0.0, 10_000.0)));
+                            }
+                        }
+                        if num(e, "Position_x").is_some() || num(e, "Position_y").is_some() {
+                            let px = num(e, "Position_x").unwrap_or(0.5).clamp(-100.0, 100.0) * w as f64;
+                            let py = num(e, "Position_y").unwrap_or(0.5).clamp(-100.0, 100.0) * h as f64;
+                            set(ti, "motion", "position", ParamValue::Vec2(Vec2::new(px, py)));
+                        }
+                        if let Some(r) = num(e, "Rotation").filter(|r| r.is_finite()) {
+                            set(ti, "motion", "rotation", ParamValue::Float(r));
+                        }
+                        if flag(e, "EnableShadow") == Some(true) {
+                            self.skip("drop shadows");
+                        }
+                    }
+                    "crop-pan-zoom" => {
+                        if e.get("paramList").and_then(Value::as_array).is_some_and(|p| !p.is_empty()) {
+                            self.skip("crop and pan-and-zoom");
+                        }
+                    }
+                    "" => {}
+                    other => self.skip(&format!("\"{other}\" effects")),
+                }
+            }
+        } else {
+            for e in effects(c, "BasicFollow") {
+                match display(e) {
+                    "volume" => {
+                        if let Some(db) = num(e, "VolumeGain").filter(|d| d.is_finite()) {
+                            ti.gain_db = db.clamp(-96.0, 96.0);
+                        }
+                        if flag(e, "Mute") == Some(true) {
+                            ti.enabled = false;
+                        }
+                    }
+                    "fade" => {
+                        fades = (
+                            num(e, "FadeInTime").filter(|s| s.is_finite() && *s > 0.0).map(Tick::from_seconds_f64),
+                            num(e, "FadeOutTime").filter(|s| s.is_finite() && *s > 0.0).map(Tick::from_seconds_f64),
+                        );
+                    }
+                    "equalizer" | "ChromaKeyV3" if e.get("paramList").and_then(Value::as_array).is_some_and(|p| !p.is_empty()) => {
+                        let d = display(e).to_string();
+                        self.skip(&format!("\"{d}\" settings"));
+                    }
+                    _ => {}
+                }
+            }
+        }
+        for chain in ["Color", "Effect", "Mask"] {
+            let names: Vec<String> = effects(c, chain).map(|e| display(e).to_string()).filter(|n| !n.is_empty()).collect();
+            for n in names {
+                let what = match chain {
+                    "Color" => "colour adjustments".to_string(),
+                    "Mask" => "masks".to_string(),
+                    _ => format!("\"{n}\" effects"),
+                };
+                // An untouched colour panel is in every clip's chain; only real settings count.
+                if chain == "Color" && !effects(c, "Color").any(|e| e.get("paramList").and_then(Value::as_array).is_some_and(|p| p.len() > 12)) {
+                    continue;
+                }
+                self.skip(&what);
+            }
+        }
+        if c.get("audio_cloud_algorithm").is_some() || c.get("video_cloud_algorithm").is_some() || c.get("humanseg_hair").is_some() {
+            self.skip("AI processing (denoise, segmentation, cloud effects)");
+        }
+        fades
+    }
+}
