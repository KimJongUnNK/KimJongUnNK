+
+/// File ▸ Open on a `.wfp` opens it as a new untitled project showing its timeline (#filmora-open):
+/// the project that was open is replaced, and saving asks for a `.fcproj` path.
+#[test]
+fn file_open_on_a_filmora_project_opens_its_timeline() {
+    let d = tmp_dir("filmora-open");
+    let timeline = r#"{"currentTimelineId":1,"timelineInfos":[{"timelineId":1,"frameRate":{"num":30,"den":1},"resolutionWidth":1080,"resolutionHeight":1920,"trackInfos":[
+        {"trackType":1,"clipList":[{"type":1,"filename":"file://Volumes/Gone/a.mov","sourceUuid":"a","inPoint":0,"outPoint":20000000,"tlBegin":0,"tlEnd":20000000}]}]}]}"#;
+    let wfp = d.join("Clubnacht.wfp");
+    let info = r#"{"timeline_mediaId":"M"}"#.to_string();
+    std::fs::write(&wfp, zip(&[("ProjectFolder/project_info.json", info), ("ProjectFolder/Medias/M/timeline.wesproj", timeline.to_string())])).unwrap();
+    let mut s = Session::default();
+    s.execute("file.newProject", json!({"name": "Old"})).unwrap();
+    let r = s.execute("file.open", json!({"path": wfp.to_string_lossy()})).unwrap();
+    assert_eq!(r["filmora"], true, "{r}");
+    assert_eq!(s.project.name, "Clubnacht");
+    assert!(s.path.is_none(), "the .wfp is not the project's file");
+    let seq = s.state.active_sequence.expect("the timeline is shown");
+    let q = s.project.sequence(seq).unwrap();
+    assert_eq!((q.settings.width, q.settings.height), (1080, 1920));
+    assert_eq!(q.video_tracks[0].items.len(), 1);
+    // Media that is not there stays offline and is reported, as for any import.
+    assert!(r["import"].to_string().contains("a.mov"), "{r}");
+    let _ = std::fs::remove_dir_all(&d);
+}
