+/// File ▸ Open on a Filmora project (`.wfp`): a new untitled project named after it, its timeline
+/// imported and shown. Saving asks where to put the `.fcproj`; the `.wfp` is never written.
+fn open_filmora(s: &mut Session, path: &str, bytes: &[u8]) -> Result<Value> {
+    let name = std::path::Path::new(path).file_stem().map(|n| n.to_string_lossy().into_owned()).unwrap_or_else(|| "Filmora Project".into());
+    crate::masks::discard_jobs(s);
+    if s.path.is_some() {
+        s.previews.reset_temp();
+    }
+    install_project(s, filmcraft_project::Project::new(&name), None, true);
+    let imported = crate::interchange::import(s, path, bytes, filmcraft_interchange::Format::Filmora, None)?;
+    let first = imported["sequences"].as_array().and_then(|a| a.first()).and_then(Value::as_u64).map(ItemId);
+    if let Some(seq) = first {
+        s.state.active_sequence = Some(seq);
+        s.state.open_sequences = Some(seq).into_iter().collect();
+        s.events.push(crate::Event::OpenSequence(seq));
+    }
+    Ok(json!({"path": path, "filmora": true, "sequence": first.map(|i| i.0), "import": imported}))
+}
