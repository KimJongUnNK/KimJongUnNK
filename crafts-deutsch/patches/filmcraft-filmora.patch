+
+    const INFO: &str = r#"{"project_file_name":"Coffee Reel","timeline_mediaId":"AA-BB"}"#;
+
+    /// Our own minimal timeline in Filmora's shape: music, a linked video+audio clip trimmed and
+    /// at 2× speed, a still at Filmora's 3600 s, a title in a compound clip with a dissolve out,
+    /// transform and volume.
+    fn timeline() -> String {
+        let speed2 = r#"{\"Version\": 3,\"keyframeSets\": [{\"_time\": 0.0,\"_value\": 2.0},{\"_time\": 1.0,\"_value\": 2.0}]}"#;
+        let title = serde_json::json!({
+            "Text": "YOU\rREADY?", "PosX": 0.5, "PosY": 0.25, "ScaleY": 0.18,
+            "Layout": {"TextAlign": "center"},
+            "TextData": [{"Basic": {"FontName": "Test Sans", "FontSize": 120.0, "FontBold": 1, "TextColor": [{"Color": 0xFF7200}], "TextAlpha": 255}}]
+        })
+        .to_string();
+        let title = serde_json::to_string(&title).unwrap_or_default();
+        format!(
+            r#"{{"currentTimelineId":1,"timelineInfos":[
+            {{"timelineId":1,"frameRate":{{"num":25,"den":1}},"resolutionWidth":1080,"resolutionHeight":1920,"trackInfos":[
+              {{"trackType":2,"clipList":[{{"type":2,"filename":"file://Volumes/Mac2/Music/song.mp3","sourceUuid":"s-music","inPoint":0,"outPoint":100000000,"tlBegin":0,"tlEnd":100000000,
+                 "effectChainList":[{{"name":"BasicFollow","effectList":[{{"display":"volume","paramList":[{{"name":"VolumeGain","fxParam":{{"paramType":2,"unValue":-6.0}}}}]}},
+                   {{"display":"fade","paramList":[{{"name":"FadeInTime","fxParam":{{"paramType":2,"unValue":1.0}}}},{{"name":"FadeOutTime","fxParam":{{"paramType":2,"unValue":2.0}}}}]}}]}}]}}]}},
+              {{"trackType":2,"trackTag":1,"clipList":[{{"type":2,"filename":"file://Volumes/LaCie/Club/IMG_1.mov","sourceUuid":"s-1","inPoint":40000000,"outPoint":80000000,"tlBegin":0,"tlEnd":20000000,"speed":{{"speedParam":"{speed2}"}}}}]}},
+              {{"trackType":1,"trackTag":2,"clipList":[
+                 {{"type":1,"filename":"file://Volumes/LaCie/Club/IMG_1.mov","sourceUuid":"s-1","inPoint":40000000,"outPoint":80000000,"tlBegin":0,"tlEnd":20000000,"speed":{{"speedParam":"{speed2}"}},
+                   "effectChainList":[{{"name":"Basic","effectList":[{{"display":"transform","paramList":[{{"name":"Scale_x","fxParam":{{"paramType":3,"unValue":150.0}}}},{{"name":"Scale_y","fxParam":{{"paramType":3,"unValue":150.0}}}},{{"name":"Position_x","fxParam":{{"paramType":3,"unValue":0.25}}}},{{"name":"Rotation","fxParam":{{"paramType":3,"unValue":10.0}}}}]}}]}},
+                     {{"name":"Effect","effectList":[{{"display":"Flip","paramList":[]}}]}}]}},
+                 {{"type":1,"filename":"file:///Users/emil/Logos/logo.png","sourceUuid":"s-2","inPoint":36000000000,"outPoint":36030000000,"tlBegin":20000000,"tlEnd":50000000}}]}},
+              {{"trackType":1,"trackTag":4,"clipList":[{{"type":7,"timelineId":2,"inPoint":0,"outPoint":30000000,"tlBegin":0,"tlEnd":30000000,"isAudio":0,
+                 "postTransition":{{"display":"Dissolve","tlBegin":25000000,"tlEnd":30000000}}}}]}}]}},
+            {{"timelineId":2,"frameRate":{{"num":25,"den":1}},"resolutionWidth":1080,"resolutionHeight":1920,"trackInfos":[
+              {{"trackType":1,"clipList":[{{"type":4,"inPoint":0,"outPoint":30000000,"tlBegin":0,"tlEnd":30000000,"scriptBuf":{title}}}]}}]}}]}}"#
+        )
+    }
+
+    fn project() -> Vec<u8> {
+        zip(&[("ProjectFolder/project_info.json", INFO), ("ProjectFolder/Medias/AA-BB/timeline.wesproj", &timeline())])
+    }
+
+    #[test]
+    fn sniffs_and_detects_filmora_projects() {
+        let p = project();
+        assert!(sniff(&p));
+        assert_eq!(crate::detect(&p, Some("wfp")), Some(Format::Filmora));
+        assert_eq!(crate::detect(&p, None), Some(Format::Filmora));
+        assert!(!sniff(&zip(&[("word/document.xml", "<w/>")])));
+        assert!(!sniff(b"PK\x03\x04 junk"));
+        assert_eq!(Format::from_extension(".WFP"), Some(Format::Filmora));
+    }
+
+    #[test]
+    fn times_convert_exactly_enough() {
+        assert_eq!(ticks(10_000_000), Tick(TICKS_PER_SECOND));
+        assert_eq!(ticks(70_400_000).seconds(), 7.04);
+        assert_eq!(ticks(-10_000_000), Tick(-TICKS_PER_SECOND));
+        assert_eq!(ticks(i64::MAX), Tick(i64::MAX));
+    }
+
+    #[test]
+    fn paths_from_filmora_urls() {
+        assert_eq!(path_of("file://Volumes/LaCie/a b.mov"), "/Volumes/LaCie/a b.mov");
+        assert_eq!(path_of("file:///Users/emil/x.png"), "/Users/emil/x.png");
+        assert_eq!(path_of("file:///C:/Videos/x.mp4"), "C:/Videos/x.mp4");
+        assert_eq!(path_of("file://Users/emil/a%20b.mov"), "/Users/emil/a b.mov");
+    }
+
+    #[test]
+    fn imports_clips_titles_transitions_and_adjustments() {
+        let (imported, _report) = crate::import(&project(), Format::Filmora, None).unwrap();
+        let p = &imported.project;
+        let seq_id = imported.sequences[0];
+        assert_eq!(p.item(seq_id).unwrap().name, "Coffee Reel");
+        let seq = p.sequence(seq_id).unwrap();
+        assert_eq!((seq.settings.width, seq.settings.height), (1080, 1920));
+        assert_eq!(seq.settings.frame_rate, FrameRate { num: 25, den: 1 });
+        let sec = |s: f64| Tick::from_seconds_f64(s);
+        // Audio: music (−6 dB, fades) on A1, the clip's own audio on A2.
+        assert_eq!(seq.audio_tracks.len(), 2);
+        let music = &seq.audio_tracks[0];
+        assert_eq!(music.items[0].gain_db, -6.0);
+        assert_eq!(music.items[0].duration, sec(10.0));
+        assert_eq!(music.transitions.len(), 2);
+        assert!(music.transitions.iter().any(|t| t.from.is_none() && t.duration == sec(1.0) && t.start == Tick::ZERO));
+        assert!(music.transitions.iter().any(|t| t.to.is_none() && t.duration == sec(2.0) && t.start == sec(8.0)));
+        // Video: trimmed at 2×, linked to its audio, Motion from Transform; then the still.
+        let v1 = &seq.video_tracks[0];
+        assert_eq!(v1.items.len(), 2);
+        let clip = &v1.items[0];
+        assert_eq!((clip.source_in, clip.duration, clip.speed), (sec(4.0), sec(2.0), 2.0));
+        assert!(clip.scale_to_frame);
+        assert_eq!(clip.link, seq.audio_tracks[1].items[0].link);
+        assert!(clip.link.is_some());
+        let motion = clip.effect("motion").unwrap();
+        assert_eq!(motion.params["scale"].value, ParamValue::Float(150.0));
+        assert_eq!(motion.params["rotation"].value, ParamValue::Float(10.0));
+        assert_eq!(motion.params["position"].value, ParamValue::Vec2(Vec2::new(270.0, 960.0)));
+        let still = &v1.items[1];
+        assert_eq!((still.start, still.duration, still.source_in), (sec(2.0), sec(3.0), Tick::ZERO));
+        assert!(matches!(p.item(still.item).unwrap().kind, ItemKind::Media(_)));
+    }
+
+    #[test]
+    fn imports_titles_as_text_graphics_with_their_transition() {
+        let (imported, _report) = crate::import(&project(), Format::Filmora, None).unwrap();
+        let p = &imported.project;
+        let seq = p.sequence(imported.sequences[0]).unwrap();
+        let sec = |s: f64| Tick::from_seconds_f64(s);
+        // The title: a graphic clip with its text, font, colour and size, and a dissolve out.
+        let v2 = &seq.video_tracks[1];
+        let title = &v2.items[0];
+        assert!(matches!(p.item(title.item).unwrap().kind, ItemKind::Graphic { width: 1080, height: 1920, .. }));
+        let layer = title.effects.iter().find(|e| graphic::is_layer(e)).unwrap();
+        assert_eq!(layer.params["text"].value, ParamValue::Text("YOU\nREADY?".into()));
+        assert_eq!(layer.params["font"].value, ParamValue::Text("Test Sans".into()));
+        assert_eq!(layer.params["fill_color"].value, ParamValue::Color([1.0, 114.0 / 255.0, 0.0, 1.0]));
+        let ParamValue::Float(size) = layer.params["size"].value else { panic!("size") };
+        assert!((size - 0.18 * 1920.0 / 2.4).abs() < 1e-6, "{size}");
+        assert_eq!(v2.transitions.len(), 1);
+        let t = &v2.transitions[0];
+        assert_eq!((t.start, t.duration, t.from, t.to, t.align), (sec(2.5), sec(0.5), Some(title.id), None, TransitionAlign::EndAtCut));
+        assert_eq!(t.effect.effect, "cross_dissolve");
+    }
+
+    #[test]
+    fn imports_media_paths_and_reports_what_it_skips() {
+        let (imported, report) = crate::import(&project(), Format::Filmora, None).unwrap();
+        let p = &imported.project;
+        // Media: paths fixed up, deduplicated.
+        let paths: Vec<String> = p
+            .items
+            .values()
+            .filter_map(|i| i.as_media())
+            .filter_map(|m| match &m.media {
+                filmcraft_project::MediaRef::File { path } => Some(path.clone()),
+                _ => None,
+            })
+            .collect();
+        for want in ["/Volumes/Mac2/Music/song.mp3", "/Volumes/LaCie/Club/IMG_1.mov", "/Users/emil/Logos/logo.png"] {
+            assert_eq!(paths.iter().filter(|p| *p == want).count(), 1, "{want}: {paths:?}");
+        }
+        // What could not be carried is reported.
+        assert!(report.mentions("Flip"), "{report}");
+    }
+
+    #[test]
+    fn hostile_archives_fail_cleanly() {
+        for bad in [Vec::new(), b"PK\x03\x04".to_vec(), zip(&[("ProjectFolder/project_info.json", "{")]), zip(&[("ProjectFolder/project_info.json", INFO)])] {
+            assert!(crate::import(&bad, Format::Filmora, None).is_err());
+        }
+        // A compound clip that contains itself.
+        let t = r#"{"currentTimelineId":1,"timelineInfos":[{"timelineId":1,"trackInfos":[{"trackType":1,"clipList":[{"type":7,"timelineId":1,"tlBegin":0,"tlEnd":10000000}]}]}]}"#;
+        let (imported, report) =
+            crate::import(&zip(&[("ProjectFolder/project_info.json", INFO), ("ProjectFolder/Medias/AA-BB/timeline.wesproj", t)]), Format::Filmora, None)
+                .unwrap();
+        assert_eq!(imported.sequences.len(), 1);
+        assert!(report.mentions("contains itself"), "{report}");
+    }
+
+    /// The user's own Filmora projects, when `FILMCRAFT_FILMORA_FIXTURES` names a folder of them
+    /// (never committed: they are private).
+    #[test]
+    fn real_filmora_projects_when_available() {
+        let Some(dir) = std::env::var_os("FILMCRAFT_FILMORA_FIXTURES") else { return };
+        let mut n = 0;
+        for e in std::fs::read_dir(dir).unwrap() {
+            let path = e.unwrap().path();
+            if path.extension().and_then(|x| x.to_str()) != Some("wfp") {
+                continue;
+            }
+            let bytes = std::fs::read(&path).unwrap();
+            let (imported, report) = crate::import(&bytes, Format::Filmora, None).unwrap();
+            let seq = imported.project.sequence(imported.sequences[0]).unwrap();
+            let clips: usize = seq.all_tracks().map(|t| t.items.len()).sum();
+            eprintln!("{}: {} video / {} audio tracks, {clips} clips\n{report}", path.display(), seq.video_tracks.len(), seq.audio_tracks.len());
+            seq.check().unwrap();
+            n += 1;
+        }
+        assert!(n > 0);
+    }
