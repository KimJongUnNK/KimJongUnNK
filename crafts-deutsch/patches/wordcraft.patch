diff --git a/crates/engine/src/cmd/options.rs b/crates/engine/src/cmd/options.rs
index add7d879..9138700b 100644
--- a/crates/engine/src/cmd/options.rs
+++ b/crates/engine/src/cmd/options.rs
@@ -272,7 +272,20 @@ fn folder_setting(key: &str, f: &str, local_only: bool) -> Result<Option<String>
 }
 
 /// Search `folder` for Hunspell dictionaries before the system locations, from now on (the saved
-/// setting, applied when the app starts and when it changes).
+/// setting, applied when the app starts and when it changes). Without one, a `dictionaries`
+/// folder shipped with the program is searched ([`bundled_dictionaries_folder`]).
 pub fn use_dictionaries_folder(folder: Option<&str>) {
-    wordcraft_proof::set_dictionaries_folder(folder.map(std::path::PathBuf::from));
+    wordcraft_proof::set_dictionaries_folder(folder.map(std::path::PathBuf::from).or_else(bundled_dictionaries_folder));
+}
+
+/// A `dictionaries` folder shipped with the program: beside the executable (a portable copy), or
+/// in a macOS app bundle's `Contents/Resources`. `None` when there is none.
+pub fn bundled_dictionaries_folder() -> Option<std::path::PathBuf> {
+    let exe = std::env::current_exe().ok()?;
+    let dir = exe.parent()?;
+    let mut candidates = vec![dir.join("dictionaries")];
+    if let Some(contents) = dir.parent() {
+        candidates.push(contents.join("Resources").join("dictionaries"));
+    }
+    candidates.into_iter().find(|d| d.is_dir())
 }
