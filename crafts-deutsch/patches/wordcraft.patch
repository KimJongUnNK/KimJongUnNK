@@ -191,6 +191,18 @@ impl Session {
             .unwrap_or_else(|| "es-ES".into())
     }
 
+    /// The German of the region in effect (`de-AT` on an Austrian system, `de-CH` on a Swiss
+    /// one, `de-DE` for German without a territory; ISO 639-2 `deu`/`ger` count as German), or
+    /// `None` when the region's language isn't German. A German interface, and an English one on
+    /// a German-speaking system, write new documents in it, so German text is proofed in German
+    /// from the first word instead of as US English.
+    pub fn region_german(&self) -> Option<String> {
+        let r = self.region();
+        matches!(r.language.as_str(), "de" | "deu" | "ger")
+            .then(|| format!("de-{}", if r.territory.is_empty() { "DE" } else { r.territory.as_str() }))
+            .and_then(|t| wordcraft_proof::lang::normalize_tag(&t))
+    }
+
     /// The unit rulers and dialogs show lengths in: the user's choice, else the region's.
     pub fn units(&self) -> wordcraft_geom::Unit {
         self.prefs.units.unwrap_or_else(|| self.region().units())
