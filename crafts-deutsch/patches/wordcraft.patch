 }
 
+/// A German interface, or an English one on a German-speaking system, writes new documents in
+/// the region's German: Austria's on an Austrian system, Switzerland's on a Swiss one.
+#[test]
+fn new_documents_follow_the_regions_german() {
+    let mut s = s();
+    s.system_region = wordcraft_geom::Region::from_tag("de_AT.UTF-8");
+    assert_eq!(s.region_german().as_deref(), Some("de-AT"));
+    s.set_editing_language(s.region_german().as_deref());
+    assert_eq!(s.doc.styles.default_chr.lang.as_deref(), Some("de-AT"), "the untouched document follows");
+    for (tag, german) in [
+        ("de-CH", Some("de-CH")),
+        ("de-DE", Some("de-DE")),
+        ("deu-LI", Some("de-LI")),
+        ("de", Some("de-DE")),
+        ("en-US", None),
+        ("fr-FR", None),
+        ("auto", Some("de-AT")),
+    ] {
+        run(&mut s, "file.options", json!({"region": tag}));
+        assert_eq!(s.region_german().as_deref(), german, "{tag}");
+    }
+    s.system_region = wordcraft_geom::Region::from_tag("en_GB.UTF-8");
+    assert_eq!(s.region_german(), None);
+}
+
 /// A Spanish interface writes new documents in the region's Spanish (#3360): Uruguay's on a
 /// Uruguayan system, Mexico's on a Mexican one, Spain's elsewhere.
 #[test]
@@ -12903,3 +12928,17 @@ fn resolving_away_an_empty_paragraph_with_a_section_break_keeps_the_next_paragra
         assert_eq!(s.doc.last_section.margin_left, 72.0, "{cmd}: the following section's setup stays");
     }
 }
+
+/// A `dictionaries` folder beside the program is searched when no dictionaries folder is set: a
+/// portable copy (or a macOS app bundle's `Contents/Resources/dictionaries`) carries its own.
+#[test]
+fn bundled_dictionaries_beside_the_program_are_found() {
+    let exe = std::env::current_exe().unwrap();
+    let dir = exe.parent().unwrap().join("dictionaries");
+    let existed = dir.is_dir();
+    std::fs::create_dir_all(&dir).unwrap();
+    assert_eq!(crate::cmd::options::bundled_dictionaries_folder().as_deref(), Some(dir.as_path()));
+    if !existed {
+        let _ = std::fs::remove_dir(&dir);
+    }
+}
