# Aus der SwitchBot-App: Profil → Einstellungen → 10× auf „App-Version“ tippen → Entwickleroptionen
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Dein Login-Passwort für die Zentrale (lang & eigen!)
APP_PASSWORD=

# Optional
# SESSION_DAYS=30          # wie lange du eingeloggt bleibst
# SESSION_SECRET=          # sonst aus Passwort + Secret abgeleitet
# PORT=8787
# HOST=0.0.0.0
# TRUST_PROXY=1            # hinter Nginx/Caddy/Tunnel: X-Forwarded-* vertrauen
# SWITCHBOT_MOCK=1         # Demo ohne echte Geräte (Passwort: demo)
